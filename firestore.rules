rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuario solo puede leer y escribir sus propios datos
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Links para compartir: cualquiera con el link puede leer; solo logueados pueden crear.
    // Nadie puede editarlos ni borrarlos (es una copia fija).
    match /shares/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['json', 'kind', 'createdAt', 'by'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000;
      allow update, delete: if false;
    }
  }
}
